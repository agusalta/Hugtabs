{
    "manifest_version": 3,
    "name": "HugTabs URL organizer",
    "short_name": "HugTabs",
    "version": "1.0.0",
    "description": "Your daily list of URLs in the Side Panel — check them every day!",
    "permissions": [
      "sidePanel",
      "storage"
    ],
    "icons": {
      "16": "icons/icon16.jpeg",
      "32": "icons/icon32.jpeg",
      "48": "icons/icon48.jpeg",
      "128": "icons/icon128.jpeg"
    },
    "side_panel": {
      "default_path": "index.html",
      "openPanelOnActionClick": true
    },
    "background": { "service_worker": "background.js" },
  "commands": {
    "open_sidepanel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Abrir panel lateral de HugTabs"
    }
  },
    "action": {
      "default_title": "Checkmate — abrir panel",
      "default_icon": {
        "16": "icons/icon16.jpeg",
        "32": "icons/icon32.jpeg",
        "48": "icons/icon48.jpeg",
        "128":"icons/icon128.jpeg"
      }
    }
  }